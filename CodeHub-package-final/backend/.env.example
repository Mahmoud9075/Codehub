# انسخ الملف ده باسم .env.local للتجربة على جهازك،
# وحط نفس القيم في Vercel > Project Settings > Environment Variables

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# مفتاح سري تختاره إنت بنفسك — بتستخدمه إنت بس عشان تفتح صفحة نتائج الطلاب (مش لازم تستخدمه دلوقتي بعد ما بقى فيه لوحة تحكم)
ADMIN_SECRET_KEY=choose-a-strong-secret-here

# رقم سري من 6 أرقام تدخل بيه على لوحة التحكم (admin.html) — إنت بس اللي تعرفه
ADMIN_PIN=123456

# من Google Cloud Console (OAuth Client ID) — عشان الأدمن الإضافي يقدر يدخل بجيميله
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# مفتاح سري عشوائي (اختار أي نص طويل وعشوائي) — بيُستخدم لتوقيع جلسة الأدمن الرئيسي (كود الإيميل)
SUPER_ADMIN_SECRET=choose-another-long-random-string

# عشان كود الدخول (OTP) يتبعت فعليًا بإيميل حقيقي — إيميل Gmail + App Password (مش الباسورد العادي)
# التفاصيل خطوة بخطوة في backend/README.md
ADMIN_EMAIL_SENDER=youremail@gmail.com
GMAIL_APP_PASS=your-16-char-app-password
